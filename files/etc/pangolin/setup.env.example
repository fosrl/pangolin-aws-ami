# Pangolin AMI settings. Provide these through EC2 user-data (see the README),
# or copy this file to /etc/pangolin/setup.env and run: sudo pangolin-setup --auto

# Required: root domain without subdomain. Used for domains.domain1.base_domain.
PANGOLIN_BASE_DOMAIN=example.com
# Optional: dashboard domain (default pangolin.<base domain>). Used for
# app.dashboard_url and gerbil.base_endpoint.
PANGOLIN_DASHBOARD_DOMAIN=pangolin.example.com
# Required: Let's Encrypt email.
PANGOLIN_EMAIL=admin@example.com

# Optional (defaults shown)
#PANGOLIN_INSTALL_GERBIL=true
#PANGOLIN_ENABLE_IPV6=        # default: true if the instance has an IPv6 address
#PANGOLIN_ENABLE_MAXMIND=true
#PANGOLIN_WAIT_FOR_DNS=true
#PANGOLIN_DNS_TIMEOUT=1800

# Optional SMTP
#PANGOLIN_SMTP_HOST=smtp.example.com
#PANGOLIN_SMTP_PORT=587
#PANGOLIN_SMTP_USER=noreply@example.com
#PANGOLIN_SMTP_PASS=change-me
#PANGOLIN_SMTP_NO_REPLY=noreply@example.com
