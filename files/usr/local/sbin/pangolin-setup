#!/usr/bin/env bash
#
# pangolin-setup - configure Pangolin on this instance.
#
#   pangolin-setup            interactive setup (run over SSH as: sudo pangolin-setup)
#   pangolin-setup --auto     unattended setup from EC2 user-data (first-boot service)
#   pangolin-setup status     show setup status
#   pangolin-setup token      print the initial admin setup token
#
# The latest Pangolin installer is downloaded at setup time, so the AMI never
# needs to be rebuilt for a new Pangolin release.

set -Eeuo pipefail

INSTALL_DIR=/opt/pangolin
STATE_DIR=/var/lib/pangolin-ami
STATE_FILE=$STATE_DIR/state
TOKEN_FILE=$STATE_DIR/setup-token
LOCK_FILE=$STATE_DIR/lock
LOG_FILE=/var/log/pangolin-setup.log
SETUP_ENV=/etc/pangolin/setup.env
INSTALLER_SCRIPT_URL=https://static.pangolin.net/get-installer.sh
IMDS=http://169.254.169.254/latest

# Settings accepted from user-data / setup.env, without the PANGOLIN_ prefix.
SETTINGS=(
    EDITION BASE_DOMAIN DASHBOARD_DOMAIN EMAIL
    INSTALL_GERBIL ENABLE_IPV6 ENABLE_MAXMIND
    SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS SMTP_NO_REPLY
    WAIT_FOR_DNS DNS_TIMEOUT INSTALLER_URL
)

BOLD=$'\033[1m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
NC=$'\033[0m'

log() { printf '[pangolin-setup] %s\n' "$*"; }
warn() { printf '[pangolin-setup] %sWARNING:%s %s\n' "$YELLOW" "$NC" "$*" >&2; }
die() {
    printf '[pangolin-setup] %sERROR:%s %s\n' "$RED" "$NC" "$*" >&2
    set_state failed
    exit 1
}

# Any unexpected failure is reported and recorded instead of exiting silently.
on_error() {
    local rc=$? line=$1
    printf '[pangolin-setup] %sERROR:%s unexpected failure (exit %s) at line %s. See %s\n' \
        "$RED" "$NC" "$rc" "$line" "$LOG_FILE" >&2
    set_state failed 2>/dev/null || true
    exit "$rc"
}

is_true() {
    case "${1,,}" in
        1 | y | yes | true | on) return 0 ;;
        *) return 1 ;;
    esac
}

bool() { if is_true "$1"; then echo true; else echo false; fi; }

edition_label() {
    if [[ ${1:-${PANGOLIN_EDITION:-community}} == enterprise ]]; then echo "Enterprise Edition"; else echo "Community Edition"; fi
}

# The edition of an existing install, read from the image in docker-compose.yml.
installed_edition() {
    local compose=$INSTALL_DIR/docker-compose.yml
    [[ -r $compose ]] || return 1
    if grep -qE 'fosrl/pangolin:ee-' "$compose"; then echo enterprise; else echo community; fi
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

set_state() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" >"$STATE_FILE.tmp"
    chmod 0644 "$STATE_FILE.tmp"
    mv -f "$STATE_FILE.tmp" "$STATE_FILE"
}

get_state() {
    if [[ -f $INSTALL_DIR/config/config.yml && ! -f $STATE_FILE ]]; then
        echo complete
    else
        cat "$STATE_FILE" 2>/dev/null || echo pending
    fi
}

acquire_lock() {
    mkdir -p "$STATE_DIR"
    exec 9>"$LOCK_FILE"
    flock -n 9
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$0" "$@"
    fi
}

# ---------------------------------------------------------------------------
# Instance metadata (IMDSv2)
# ---------------------------------------------------------------------------

imds_get() {
    local token
    token=$(curl -fsS --max-time 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' "$IMDS/api/token" 2>/dev/null) || return 1
    curl -fsS --max-time 2 -H "X-aws-ec2-metadata-token: $token" "$IMDS/$1" 2>/dev/null
}

public_ipv4() { imds_get meta-data/public-ipv4 || true; }

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

# Read PANGOLIN_KEY=value lines from stdin. Only allow-listed keys are taken
# and nothing is evaluated, so arbitrary user-data is safe to parse. Lines may
# be indented (cloud-config) or prefixed with "export" (shell scripts).
parse_settings() {
    local line key value name
    local line_re='^[[:space:]]*(export[[:space:]]+)?PANGOLIN_([A-Z0-9_]+)=(.*)$'
    local dq_re='^"(.*)"$' sq_re="^'(.*)'$"
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ $line =~ $line_re ]] || continue
        key=${BASH_REMATCH[2]}
        value=${BASH_REMATCH[3]}
        value=${value%"${value##*[![:space:]]}"}
        if [[ $value =~ $dq_re || $value =~ $sq_re ]]; then
            value=${BASH_REMATCH[1]}
        fi
        [[ $key == LETSENCRYPT_EMAIL ]] && key=EMAIL
        for name in "${SETTINGS[@]}"; do
            if [[ $name == "$key" ]]; then
                printf -v "PANGOLIN_$key" '%s' "$value"
            fi
        done
    done
}

load_settings() {
    if [[ -f $SETUP_ENV ]]; then
        parse_settings <"$SETUP_ENV"
        return 0
    fi
    local user_data
    if user_data=$(imds_get user-data); then
        parse_settings <<<"$user_data"
    fi
}

save_settings() {
    local name var
    mkdir -p "$(dirname "$SETUP_ENV")"
    (
        umask 077
        {
            echo "# Pangolin AMI setup settings. Written by pangolin-setup."
            for name in "${SETTINGS[@]}"; do
                var=PANGOLIN_$name
                if [[ -n ${!var:-} ]]; then
                    printf '%s=%s\n' "$var" "${!var}"
                fi
            done
        } >"$SETUP_ENV"
    )
}

normalize_domain() {
    local d=${1,,}
    d=${d#http://}
    d=${d#https://}
    d=${d%%/*}
    d=${d%.}
    printf '%s' "$d"
}

valid_domain() {
    local re='^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z0-9-]{2,63}$'
    [[ $1 =~ $re ]]
}

# The base domain feeds domains.domain1.base_domain and the dashboard domain
# feeds app.dashboard_url / gerbil.base_endpoint, so both are always resolved:
# either may be given and the other is derived.
resolve_edition() {
    local edition=${PANGOLIN_EDITION:-}
    case "${edition,,}" in
        "" | ce | community) PANGOLIN_EDITION=community ;;
        ee | enterprise) PANGOLIN_EDITION=enterprise ;;
    esac
}

resolve_domains() {
    PANGOLIN_BASE_DOMAIN=$(normalize_domain "${PANGOLIN_BASE_DOMAIN:-}")
    PANGOLIN_DASHBOARD_DOMAIN=$(normalize_domain "${PANGOLIN_DASHBOARD_DOMAIN:-}")

    if [[ -z $PANGOLIN_BASE_DOMAIN && -n $PANGOLIN_DASHBOARD_DOMAIN ]]; then
        local dots=${PANGOLIN_DASHBOARD_DOMAIN//[^.]/}
        if [[ ${#dots} -le 1 ]]; then
            PANGOLIN_BASE_DOMAIN=$PANGOLIN_DASHBOARD_DOMAIN
        else
            PANGOLIN_BASE_DOMAIN=${PANGOLIN_DASHBOARD_DOMAIN#*.}
        fi
    fi
    if [[ -z $PANGOLIN_DASHBOARD_DOMAIN && -n $PANGOLIN_BASE_DOMAIN ]]; then
        PANGOLIN_DASHBOARD_DOMAIN=pangolin.$PANGOLIN_BASE_DOMAIN
    fi
}

# Prints one problem per line; returns non-zero if anything is wrong.
validate_settings() {
    local problems=()
    if [[ $PANGOLIN_EDITION != community && $PANGOLIN_EDITION != enterprise ]]; then
        problems+=("PANGOLIN_EDITION '$PANGOLIN_EDITION' must be community or enterprise")
    fi
    if [[ -z ${PANGOLIN_BASE_DOMAIN:-} ]]; then
        problems+=("PANGOLIN_BASE_DOMAIN (or PANGOLIN_DASHBOARD_DOMAIN) is not set")
    elif ! valid_domain "$PANGOLIN_BASE_DOMAIN"; then
        problems+=("PANGOLIN_BASE_DOMAIN '$PANGOLIN_BASE_DOMAIN' is not a valid domain")
    fi
    if [[ -n ${PANGOLIN_DASHBOARD_DOMAIN:-} ]] && ! valid_domain "$PANGOLIN_DASHBOARD_DOMAIN"; then
        problems+=("PANGOLIN_DASHBOARD_DOMAIN '$PANGOLIN_DASHBOARD_DOMAIN' is not a valid domain")
    fi
    if [[ -z ${PANGOLIN_EMAIL:-} ]]; then
        problems+=("PANGOLIN_EMAIL is not set")
    elif [[ $PANGOLIN_EMAIL != *@*.* ]]; then
        problems+=("PANGOLIN_EMAIL '$PANGOLIN_EMAIL' is not a valid email address")
    fi
    if [[ -n ${PANGOLIN_SMTP_HOST:-} ]]; then
        [[ -z ${PANGOLIN_SMTP_USER:-} ]] && problems+=("PANGOLIN_SMTP_USER is required when PANGOLIN_SMTP_HOST is set")
        [[ -z ${PANGOLIN_SMTP_PASS:-} ]] && problems+=("PANGOLIN_SMTP_PASS is required when PANGOLIN_SMTP_HOST is set")
        if [[ -n ${PANGOLIN_SMTP_PORT:-} && ! $PANGOLIN_SMTP_PORT =~ ^[0-9]+$ ]]; then
            problems+=("PANGOLIN_SMTP_PORT '$PANGOLIN_SMTP_PORT' is not a number")
        fi
    fi

    if ((${#problems[@]})); then
        printf '%s\n' "${problems[@]}"
        return 1
    fi

    if [[ $PANGOLIN_DASHBOARD_DOMAIN != "$PANGOLIN_BASE_DOMAIN" && $PANGOLIN_DASHBOARD_DOMAIN != *."$PANGOLIN_BASE_DOMAIN" ]]; then
        warn "dashboard domain $PANGOLIN_DASHBOARD_DOMAIN is not under base domain $PANGOLIN_BASE_DOMAIN"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# DNS
# ---------------------------------------------------------------------------

resolve_a() {
    local server
    for server in 1.1.1.1 8.8.8.8; do
        dig +short +time=2 +tries=1 A "$1" @"$server" 2>/dev/null | grep -E '^[0-9.]+$' || true
    done | sort -u
}

dns_matches() {
    local ip=$1 resolved
    resolved=$(resolve_a "$PANGOLIN_DASHBOARD_DOMAIN")
    grep -qxF "$ip" <<<"$resolved"
}

print_dns_records() {
    local ip=${1:-<public IP of this instance>}
    cat <<EOF
  Create these DNS records before Let's Encrypt can issue certificates:

    A  ${PANGOLIN_DASHBOARD_DOMAIN}  ->  ${ip}
    A  *.${PANGOLIN_BASE_DOMAIN}  ->  ${ip}   (for the resources you expose)

  Use an Elastic IP so the address survives instance stop/start.
EOF
}

# Let's Encrypt HTTP validation fails until the dashboard domain points here,
# so wait (bounded) for DNS before starting the stack.
wait_for_dns() {
    local timeout=${PANGOLIN_DNS_TIMEOUT:-1800} start=$SECONDS last_log=-60 ip resolved
    [[ $timeout =~ ^[0-9]+$ ]] || timeout=1800

    while true; do
        ip=$(public_ipv4)
        if [[ -z $ip ]] && ((SECONDS - start > 300)); then
            warn "no public IPv4 address found; skipping the DNS check"
            return 0
        fi
        if [[ -n $ip ]] && dns_matches "$ip"; then
            log "DNS ok: $PANGOLIN_DASHBOARD_DOMAIN -> $ip"
            return 0
        fi
        if ((SECONDS - start >= timeout)); then
            warn "timed out after ${timeout}s waiting for $PANGOLIN_DASHBOARD_DOMAIN to resolve to ${ip:-this instance}; continuing anyway"
            return 1
        fi
        if ((SECONDS - last_log >= 60)); then
            resolved=$(resolve_a "$PANGOLIN_DASHBOARD_DOMAIN" | tr '\n' ' ')
            log "waiting for DNS: $PANGOLIN_DASHBOARD_DOMAIN should resolve to ${ip:-<public ip>} (currently: ${resolved:-nothing})"
            last_log=$SECONDS
        fi
        sleep 15
    done
}

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

ensure_docker() {
    systemctl start docker >/dev/null 2>&1 || true
    local _
    for _ in $(seq 1 30); do
        docker info >/dev/null 2>&1 && return 0
        sleep 2
    done
    die "Docker is not running"
}

fetch_installer() {
    mkdir -p "$INSTALL_DIR"
    cd "$INSTALL_DIR"
    rm -f installer

    local attempt
    for attempt in 1 2 3 4 5; do
        if [[ -n ${PANGOLIN_INSTALLER_URL:-} ]]; then
            log "downloading installer from $PANGOLIN_INSTALLER_URL"
            curl -fsSL "$PANGOLIN_INSTALLER_URL" -o installer.tmp && mv -f installer.tmp installer && break
        else
            log "downloading the latest Pangolin installer"
            curl -fsSL "$INSTALLER_SCRIPT_URL" | bash && break
        fi
        warn "installer download failed (attempt $attempt/5)"
        sleep $((attempt * 5))
    done

    [[ -f installer ]] || die "could not download the Pangolin installer"
    chmod +x installer

    if ! ./installer --help 2>&1 | grep -q -- '-non-interactive'; then
        die "the downloaded installer does not support --non-interactive; a newer installer release is required"
    fi
}

ipv6_default() {
    if [[ -n $(imds_get meta-data/ipv6 || true) ]]; then echo true; else echo false; fi
}

wait_for_pangolin() {
    local _ status
    for _ in $(seq 1 60); do
        status=$(docker inspect -f '{{.State.Health.Status}}' pangolin 2>/dev/null || true)
        [[ $status == healthy ]] && return 0
        sleep 5
    done
    return 1
}

capture_token() {
    local output_file=$1 token
    token=$(sed -n 's/^Setup token:[[:space:]]*//p' "$output_file" | tail -n1)
    if [[ -z $token ]]; then
        token=$(docker logs pangolin 2>&1 | grep -A4 'SETUP TOKEN' | sed -n 's/.*Token:[[:space:]]*//p' | tail -n1 || true)
    fi
    if [[ -n $token ]]; then
        (
            umask 077
            printf '%s\n' "$token" >"$TOKEN_FILE"
        )
    fi
}

run_installer() {
    local enterprise=false
    [[ $PANGOLIN_EDITION == enterprise ]] && enterprise=true

    local args=(
        --non-interactive
        --install-dir "$INSTALL_DIR"
        --container-type docker
        --start-containers=true
        --enterprise="$enterprise"
        --base-domain "$PANGOLIN_BASE_DOMAIN"
        --dashboard-domain "$PANGOLIN_DASHBOARD_DOMAIN"
        --letsencrypt-email "$PANGOLIN_EMAIL"
        --gerbil="$(bool "${PANGOLIN_INSTALL_GERBIL:-true}")"
        --ipv6="$(bool "${PANGOLIN_ENABLE_IPV6:-$(ipv6_default)}")"
        --maxmind="$(bool "${PANGOLIN_ENABLE_MAXMIND:-true}")"
    )
    if [[ -n ${PANGOLIN_SMTP_HOST:-} ]]; then
        local no_reply=${PANGOLIN_SMTP_NO_REPLY:-}
        if [[ -z $no_reply ]]; then
            if [[ $PANGOLIN_SMTP_USER == *@* ]]; then no_reply=$PANGOLIN_SMTP_USER; else no_reply=$PANGOLIN_EMAIL; fi
        fi
        args+=(
            --email
            --smtp-host "$PANGOLIN_SMTP_HOST"
            --smtp-port "${PANGOLIN_SMTP_PORT:-587}"
            --smtp-user "$PANGOLIN_SMTP_USER"
            --smtp-pass "$PANGOLIN_SMTP_PASS"
            --smtp-no-reply "$no_reply"
        )
    fi

    local output_file
    output_file=$(mktemp)
    log "running the Pangolin installer ($(edition_label))"
    ./installer "${args[@]}" </dev/null 2>&1 | tee "$output_file"

    # The installer exits 0 on some failures, so verify the result directly.
    [[ -f $INSTALL_DIR/config/config.yml ]] || die "installer did not generate $INSTALL_DIR/config/config.yml"
    wait_for_pangolin || die "the pangolin container did not become healthy; see: cd $INSTALL_DIR && docker compose logs pangolin"

    capture_token "$output_file"
    rm -f "$output_file"
}

print_summary() {
    local token=""
    [[ -f $TOKEN_FILE ]] && token=$(<"$TOKEN_FILE")
    cat <<EOF

=================================================================
 Pangolin $(edition_label) is installed
=================================================================

  Dashboard:      https://${PANGOLIN_DASHBOARD_DOMAIN}
  Initial setup:  https://${PANGOLIN_DASHBOARD_DOMAIN}/auth/initial-setup
  Setup token:    ${token:-<not found - run: sudo pangolin-setup token>}

  The setup token registers the first admin account and is invalid
  after that account is created. Retrieve it again with:
    sudo pangolin-setup token

  Certificates can take a few minutes to issue after DNS resolves.
  Install directory: ${INSTALL_DIR}   Log: ${LOG_FILE}
EOF
    if [[ $PANGOLIN_EDITION == enterprise ]]; then
        cat <<EOF

  Enterprise Edition: activate your license key under
  Server Admin -> License (https://${PANGOLIN_DASHBOARD_DOMAIN}/admin/license).
EOF
    fi
    echo "================================================================="
}

do_install() {
    ensure_docker
    fetch_installer
    set_state installing
    run_installer
    set_state complete
    print_summary
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_auto() {
    trap 'on_error $LINENO' ERR
    mkdir -p "$STATE_DIR"
    exec > >(tee -a "$LOG_FILE") 2>&1

    if [[ -f $INSTALL_DIR/config/config.yml ]]; then
        log "Pangolin is already configured; nothing to do"
        exit 0
    fi
    acquire_lock || { log "another pangolin-setup is running"; exit 0; }

    log "waiting for cloud-init to finish"
    cloud-init status --wait >/dev/null 2>&1 || true

    load_settings
    resolve_edition
    resolve_domains

    local problems
    if ! problems=$(validate_settings); then
        set_state needs-input
        log "Pangolin was not configured from user-data:"
        while IFS= read -r line; do log "  - $line"; done <<<"$problems"
        log "Provide PANGOLIN_BASE_DOMAIN and PANGOLIN_EMAIL in user-data, or SSH in and run: sudo pangolin-setup"
        exit 0
    fi
    save_settings

    if is_true "${PANGOLIN_WAIT_FOR_DNS:-true}"; then
        set_state waiting-dns
        wait_for_dns || true
    fi
    do_install
}

ask() {
    local prompt=$1 default=${2:-} reply
    while true; do
        if [[ -n $default ]]; then
            read -r -p "$prompt [$default]: " reply </dev/tty
        else
            read -r -p "$prompt: " reply </dev/tty
        fi
        reply=${reply:-$default}
        [[ -n $reply ]] && break
        echo "  A value is required." >&2
    done
    printf '%s' "$reply"
}

ask_secret() {
    local prompt=$1 reply
    while true; do
        read -r -s -p "$prompt: " reply </dev/tty
        echo >&2
        [[ -n $reply ]] && break
        echo "  A value is required." >&2
    done
    printf '%s' "$reply"
}

confirm() {
    local prompt=$1 default=${2:-y} reply hint="[Y/n]"
    [[ $default == n ]] && hint="[y/N]"
    read -r -p "$prompt $hint " reply </dev/tty
    reply=${reply:-$default}
    [[ ${reply,,} == y* ]]
}

cmd_interactive() {
    require_root
    trap 'on_error $LINENO' ERR

    case $(get_state) in
        complete)
            cmd_status
            exit 0
            ;;
    esac
    if ! acquire_lock; then
        echo "Pangolin setup is already running (started from user-data)."
        echo "Follow its progress with: sudo tail -f $LOG_FILE"
        exit 0
    fi

    clear || true
    cat <<EOF
${BOLD}=================================================================${NC}
 ${GREEN}Welcome to Pangolin${NC}
${BOLD}=================================================================${NC}

 This will configure Pangolin on this instance using the latest
 release. Before continuing, make sure that:

   1. You have a domain whose DNS you control
   2. The security group allows TCP 80, 443 and UDP 51820, 21820

EOF

    load_settings
    resolve_edition
    resolve_domains

    local edition_default=n
    [[ $PANGOLIN_EDITION == enterprise ]] && edition_default=y
    echo " The Enterprise Edition is free for personal use and for businesses"
    echo " under \$100K USD gross annual revenue. See https://docs.pangolin.net/self-host/enterprise-edition"
    if confirm "Install the Enterprise Edition?" "$edition_default"; then
        PANGOLIN_EDITION=enterprise
    else
        PANGOLIN_EDITION=community
    fi
    echo

    local base dashboard
    while true; do
        base=$(normalize_domain "$(ask "Base domain, without subdomain (e.g. example.com)" "${PANGOLIN_BASE_DOMAIN:-}")")
        valid_domain "$base" && break
        echo "  '$base' is not a valid domain." >&2
    done
    PANGOLIN_BASE_DOMAIN=$base
    while true; do
        dashboard=$(normalize_domain "$(ask "Dashboard domain" "${PANGOLIN_DASHBOARD_DOMAIN:-pangolin.$base}")")
        valid_domain "$dashboard" && break
        echo "  '$dashboard' is not a valid domain." >&2
    done
    PANGOLIN_DASHBOARD_DOMAIN=$dashboard

    while true; do
        PANGOLIN_EMAIL=$(ask "Email for Let's Encrypt certificates" "${PANGOLIN_EMAIL:-}")
        [[ $PANGOLIN_EMAIL == *@*.* ]] && break
        echo "  '$PANGOLIN_EMAIL' is not a valid email address." >&2
    done

    if confirm "Install Gerbil for tunneled connections (recommended)?" y; then
        PANGOLIN_INSTALL_GERBIL=true
    else
        PANGOLIN_INSTALL_GERBIL=false
    fi

    if confirm "Configure SMTP email now? (can be added later)" n; then
        PANGOLIN_SMTP_HOST=$(ask "SMTP host" "${PANGOLIN_SMTP_HOST:-}")
        PANGOLIN_SMTP_PORT=$(ask "SMTP port" "${PANGOLIN_SMTP_PORT:-587}")
        PANGOLIN_SMTP_USER=$(ask "SMTP username" "${PANGOLIN_SMTP_USER:-}")
        PANGOLIN_SMTP_PASS=$(ask_secret "SMTP password")
        PANGOLIN_SMTP_NO_REPLY=$(ask "No-reply address" "${PANGOLIN_SMTP_NO_REPLY:-$PANGOLIN_SMTP_USER}")
    else
        PANGOLIN_SMTP_HOST="" PANGOLIN_SMTP_PORT="" PANGOLIN_SMTP_USER="" PANGOLIN_SMTP_PASS="" PANGOLIN_SMTP_NO_REPLY=""
    fi

    local problems
    if ! problems=$(validate_settings); then
        echo "$problems" >&2
        exit 1
    fi

    local ip reply
    ip=$(public_ipv4)
    echo
    print_dns_records "$ip"
    echo
    if [[ -n $ip ]]; then
        while ! dns_matches "$ip"; do
            echo "  ${YELLOW}$PANGOLIN_DASHBOARD_DOMAIN does not resolve to $ip yet.${NC}"
            read -r -p "  [r]etry, [c]ontinue anyway, or [a]bort? [r] " reply </dev/tty
            case ${reply,,} in
                c*) break ;;
                a*) exit 1 ;;
                *) sleep 5 ;;
            esac
        done
        dns_matches "$ip" && echo "  ${GREEN}DNS ok:${NC} $PANGOLIN_DASHBOARD_DOMAIN -> $ip"
    fi

    cat <<EOF

 Summary
   Edition:          $(edition_label)
   Base domain:      $PANGOLIN_BASE_DOMAIN
   Dashboard domain: $PANGOLIN_DASHBOARD_DOMAIN
   Let's Encrypt:    $PANGOLIN_EMAIL
   Gerbil:           $PANGOLIN_INSTALL_GERBIL
   SMTP:             ${PANGOLIN_SMTP_HOST:-disabled}

EOF
    confirm "Install Pangolin now?" y || exit 1

    save_settings
    exec > >(tee -a "$LOG_FILE") 2>&1
    do_install
}

cmd_status() {
    local state dashboard="" edition
    state=$(get_state)
    if [[ -f $INSTALL_DIR/config/config.yml ]]; then
        dashboard=$(sed -n 's/^[[:space:]]*dashboard_url:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' "$INSTALL_DIR/config/config.yml" | head -n1)
    fi
    if edition=$(installed_edition); then
        echo "Pangolin $(edition_label "$edition")"
    else
        echo "Pangolin"
    fi
    echo "  Setup state: $state"
    [[ -n $dashboard ]] && echo "  Dashboard:   $dashboard"
    case $state in
        pending) echo "  First-boot setup has not run yet." ;;
        needs-input) echo "  No settings were found in user-data. Run: sudo pangolin-setup" ;;
        waiting-dns) echo "  Waiting for DNS. Follow progress: sudo tail -f $LOG_FILE" ;;
        installing) echo "  Installing. Follow progress: sudo tail -f $LOG_FILE" ;;
        failed) echo "  Setup failed. See $LOG_FILE, then re-run: sudo pangolin-setup" ;;
        complete) echo "  Setup token: sudo pangolin-setup token" ;;
    esac
}

cmd_token() {
    require_root token
    if [[ -f $TOKEN_FILE ]]; then
        cat "$TOKEN_FILE"
        return 0
    fi
    local token
    token=$(docker logs pangolin 2>&1 | grep -A4 'SETUP TOKEN' | sed -n 's/.*Token:[[:space:]]*//p' | tail -n1 || true)
    [[ -n $token ]] || { echo "No setup token found. Is Pangolin running?" >&2; exit 1; }
    echo "$token"
}

usage() { sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
    case ${1:-} in
        "") cmd_interactive ;;
        --auto) cmd_auto ;;
        status) cmd_status ;;
        token) cmd_token ;;
        -h | --help | help) usage ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
